{
  "name": "tursoft-claude-code-account-switcher",
  "displayName": "Tursoft Claude Multi-Account Switcher",
  "description": "Quickly switch between Claude accounts (subscriptions) in Claude Code, with live usage limits.",
  "version": "0.3.1",
  "publisher": "Muhammet Tursak",
  "author": {
    "name": "Muhammet Tursak",
    "email": "tursoft@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "account",
    "switcher",
    "usage",
    "limits"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tursoft/claude-account-switcher"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tursoftClaudeSwitcher",
          "title": "MultiAccount",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tursoftClaudeSwitcher": [
        {
          "id": "tursoftClaudeSwitcher.accountsView",
          "name": "Accounts",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tursoftClaudeSwitcher.addCurrentAccount",
        "title": "Claude: Save current account as profile",
        "icon": "$(add)"
      },
      {
        "command": "tursoftClaudeSwitcher.addAccount",
        "title": "Claude: Add another account (isolated login)",
        "icon": "$(person-add)"
      },
      {
        "command": "tursoftClaudeSwitcher.switchAccount",
        "title": "Claude: Switch account",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "tursoftClaudeSwitcher.refreshAll",
        "title": "Claude: Refresh accounts, current login and limits",
        "icon": "$(refresh)"
      },
      {
        "command": "tursoftClaudeSwitcher.refreshUsage",
        "title": "Claude: Refresh usage limits",
        "icon": "$(refresh)"
      },
      {
        "command": "tursoftClaudeSwitcher.sayHi",
        "title": "Claude: Say Hi on account",
        "icon": "$(comment)"
      },
      {
        "command": "tursoftClaudeSwitcher.openIndependentWindow",
        "title": "Claude: Open independent account window",
        "icon": "$(window)"
      },
      {
        "command": "tursoftClaudeSwitcher.login",
        "title": "Claude: Log in from terminal (replaces the current account)",
        "icon": "$(sign-in)"
      },
      {
        "command": "tursoftClaudeSwitcher.browserLogin",
        "title": "Claude: Authorize in browser (without CLI)",
        "icon": "$(globe)"
      },
      {
        "command": "tursoftClaudeSwitcher.reauthorizeProfile",
        "title": "Claude: Reauthorize account profile",
        "icon": "$(sign-in)"
      },
      {
        "command": "tursoftClaudeSwitcher.completeProfileReauthorization",
        "title": "Claude: Complete profile reauthorization",
        "icon": "$(pass)"
      },
      {
        "command": "tursoftClaudeSwitcher.removeAccount",
        "title": "Claude: Remove account profile"
      },
      {
        "command": "tursoftClaudeSwitcher.renameAccount",
        "title": "Claude: Rename account profile"
      },
      {
        "command": "tursoftClaudeSwitcher.undoSwitch",
        "title": "Claude: Undo last switch"
      },
      {
        "command": "tursoftClaudeSwitcher.openPanel",
        "title": "Claude: Show accounts panel"
      },
      {
        "command": "tursoftClaudeSwitcher.backupAccounts",
        "title": "Claude: Back up account list (password-protected ZIP)",
        "icon": "$(archive)"
      },
      {
        "command": "tursoftClaudeSwitcher.restoreAccounts",
        "title": "Claude: Restore account list from backup",
        "icon": "$(history)"
      },
      {
        "command": "tursoftClaudeSwitcher.about",
        "title": "Claude: About Tursoft Claude Multi-Account Switcher",
        "icon": "$(info)"
      },
      {
        "command": "tursoftClaudeSwitcher.openSettings",
        "title": "Claude: Open extension settings",
        "icon": "$(gear)"
      },
      {
        "command": "tursoftClaudeSwitcher.clearUsageHistory",
        "title": "Claude: Delete collected usage history"
      },
      {
        "command": "tursoftClaudeSwitcher.openAnalytics",
        "title": "Claude: Show usage analytics",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tursoftClaudeSwitcher.refreshAll",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "navigation@1"
        },
        {
          "command": "tursoftClaudeSwitcher.addCurrentAccount",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "1_accounts@1"
        },
        {
          "command": "tursoftClaudeSwitcher.addAccount",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "1_accounts@2"
        },
        {
          "command": "tursoftClaudeSwitcher.browserLogin",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "1_accounts@3"
        },
        {
          "command": "tursoftClaudeSwitcher.reauthorizeProfile",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "1_accounts@4"
        },
        {
          "command": "tursoftClaudeSwitcher.sayHi",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "2_tools@1"
        },
        {
          "command": "tursoftClaudeSwitcher.openIndependentWindow",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "2_tools@2"
        },
        {
          "command": "tursoftClaudeSwitcher.backupAccounts",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "3_backup@1"
        },
        {
          "command": "tursoftClaudeSwitcher.restoreAccounts",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "3_backup@2"
        },
        {
          "command": "tursoftClaudeSwitcher.openAnalytics",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "4_views@1"
        },
        {
          "command": "tursoftClaudeSwitcher.openSettings",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "9_about@0"
        },
        {
          "command": "tursoftClaudeSwitcher.about",
          "when": "view == tursoftClaudeSwitcher.accountsView",
          "group": "9_about@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tursoftClaudeSwitcher.removeAccount"
        },
        {
          "command": "tursoftClaudeSwitcher.renameAccount"
        }
      ]
    },
    "configuration": {
      "title": "Claude Account Switcher",
      "properties": {
        "tursoftClaudeSwitcher.autoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Regularly check the usage limits of all saved accounts (every `#tursoftClaudeSwitcher.pollIntervalSeconds#` seconds). When disabled, usage is only checked at startup, on manual refresh, and when a used-up limit is due to reset."
        },
        "tursoftClaudeSwitcher.pollIntervalSeconds": {
          "type": "number",
          "default": 240,
          "minimum": 60,
          "markdownDescription": "How often (in seconds, minimum 60 = 1 minute) to check usage limits for each account when `#tursoftClaudeSwitcher.autoRefresh#` is on. The usage endpoint is rate-limited: short intervals with many accounts can hit HTTP 429, after which that account is paused for 5 minutes."
        },
        "tursoftClaudeSwitcher.notifyOnLimitReset": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a notification when a used-up limit (session, weekly, or a model-specific weekly limit) of a saved account becomes available again."
        },
        "tursoftClaudeSwitcher.autoReloadAfterSwitch": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Automatically reload the VS Code window after switching accounts (required for Claude Code to pick up the new account). When disabled, the extension asks first."
        },
        "tursoftClaudeSwitcher.credentialsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Claude Code `.credentials.json` file. Empty = default `~/.claude/.credentials.json`."
        },
        "tursoftClaudeSwitcher.warnThresholdPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "Usage threshold (%) above which the limit bar turns red."
        },
        "tursoftClaudeSwitcher.claudeCommand": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Claude Code CLI command used for login and Say Hi warmups. Use the full path to `claude.cmd`/`claude.exe` if VS Code cannot find `claude` in PATH."
        },
        "tursoftClaudeSwitcher.sayHiModel": {
          "type": "string",
          "default": "haiku",
          "markdownDescription": "Model passed to `claude -p` for Say Hi warmups. `haiku` is the low-cost/default warmup choice."
        },
        "tursoftClaudeSwitcher.sayHiPrompt": {
          "type": "string",
          "default": "Hi",
          "markdownDescription": "Prompt used by Say Hi warmups."
        },
        "tursoftClaudeSwitcher.sayHiTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 15,
          "markdownDescription": "Maximum time to wait for a Say Hi warmup command."
        },
        "tursoftClaudeSwitcher.usageHistory.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Collect a usage reading of every saved account every `#tursoftClaudeSwitcher.usageHistory.intervalSeconds#` seconds and keep it on this computer, for the usage analytics charts and the availability calendar. Readings that repeat the previous values are not stored again (except every 15 minutes)."
        },
        "tursoftClaudeSwitcher.usageHistory.intervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 60,
          "markdownDescription": "How often (in seconds, minimum 60) usage is read while `#tursoftClaudeSwitcher.usageHistory.enabled#` is on. Short periods with many accounts can hit the usage endpoint's rate limit (HTTP 429), which pauses that account for 5 minutes."
        },
        "tursoftClaudeSwitcher.usageHistory.retentionDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "markdownDescription": "How many days of collected usage history to keep."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node test/run-smoke.cjs",
    "build:vsix": "npm run package && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "chart.js": "^4.5.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.23.0"
  }
}
