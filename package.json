{
  "name": "account-manager-for-claude",
  "displayName": "Claude Account Manager",
  "description": "Seamlessly switch between Claude accounts and subscriptions in Claude Code, with real-time usage limit tracking.",
  "version": "1.0.7",
  "publisher": "tursoft",
  "author": {
    "name": "Muhammet Tursak",
    "email": "tursoft@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "llm",
    "ai",
    "account",
    "switcher",
    "manager",
    "usage",
    "limits"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tursoft/account-manager-for-claude"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "accountManagerForClaude",
          "title": "Claude Account Manager",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "accountManagerForClaude": [
        {
          "id": "accountManagerForClaude.accountsView",
          "name": "Accounts",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "accountManagerForClaude.addCurrentAccount",
        "title": "Claude: Save current account as profile",
        "icon": "$(add)"
      },
      {
        "command": "accountManagerForClaude.addAccount",
        "title": "Claude: Add another account (isolated login)",
        "icon": "$(person-add)"
      },
      {
        "command": "accountManagerForClaude.switchAccount",
        "title": "Claude: Switch account",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "accountManagerForClaude.refreshAll",
        "title": "Claude: Refresh accounts, current login and limits",
        "icon": "$(refresh)"
      },
      {
        "command": "accountManagerForClaude.refreshUsage",
        "title": "Claude: Refresh usage limits",
        "icon": "$(refresh)"
      },
      {
        "command": "accountManagerForClaude.sayHi",
        "title": "Claude: Say Hi on account",
        "icon": "$(comment)"
      },
      {
        "command": "accountManagerForClaude.openIndependentWindow",
        "title": "Claude: Open independent account window",
        "icon": "$(window)"
      },
      {
        "command": "accountManagerForClaude.login",
        "title": "Claude: Log in from terminal (replaces the current account)",
        "icon": "$(sign-in)"
      },
      {
        "command": "accountManagerForClaude.browserLogin",
        "title": "Claude: Authorize in browser (without CLI)",
        "icon": "$(globe)"
      },
      {
        "command": "accountManagerForClaude.reauthorizeProfile",
        "title": "Claude: Reauthorize account profile",
        "icon": "$(sign-in)"
      },
      {
        "command": "accountManagerForClaude.completeProfileReauthorization",
        "title": "Claude: Complete profile reauthorization",
        "icon": "$(pass)"
      },
      {
        "command": "accountManagerForClaude.removeAccount",
        "title": "Claude: Remove account profile"
      },
      {
        "command": "accountManagerForClaude.renameAccount",
        "title": "Claude: Rename account profile"
      },
      {
        "command": "accountManagerForClaude.undoSwitch",
        "title": "Claude: Undo last switch"
      },
      {
        "command": "accountManagerForClaude.openPanel",
        "title": "Claude: Show accounts panel"
      },
      {
        "command": "accountManagerForClaude.backupAccounts",
        "title": "Claude: Back up account list (password-protected ZIP)",
        "icon": "$(archive)"
      },
      {
        "command": "accountManagerForClaude.restoreAccounts",
        "title": "Claude: Restore account list from backup",
        "icon": "$(history)"
      },
      {
        "command": "accountManagerForClaude.about",
        "title": "Claude: About Account Manager for Claude",
        "icon": "$(info)"
      },
      {
        "command": "accountManagerForClaude.clearUsageHistory",
        "title": "Claude: Delete collected usage history"
      },
      {
        "command": "accountManagerForClaude.openAnalytics",
        "title": "Claude: Show usage analytics",
        "icon": "$(graph)"
      },
      {
        "command": "accountManagerForClaude.openAvailability",
        "title": "Claude: Show account availability calendar",
        "icon": "$(calendar)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "accountManagerForClaude.openAnalytics",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "navigation@1"
        },
        {
          "command": "accountManagerForClaude.openAvailability",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "navigation@2"
        },
        {
          "command": "accountManagerForClaude.refreshAll",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "navigation@3"
        },
        {
          "command": "accountManagerForClaude.addCurrentAccount",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "1_accounts@1"
        },
        {
          "command": "accountManagerForClaude.addAccount",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "1_accounts@2"
        },
        {
          "command": "accountManagerForClaude.browserLogin",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "1_accounts@3"
        },
        {
          "command": "accountManagerForClaude.reauthorizeProfile",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "1_accounts@4"
        },
        {
          "command": "accountManagerForClaude.sayHi",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "2_tools@1"
        },
        {
          "command": "accountManagerForClaude.openIndependentWindow",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "2_tools@2"
        },
        {
          "command": "accountManagerForClaude.backupAccounts",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "3_backup@1"
        },
        {
          "command": "accountManagerForClaude.restoreAccounts",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "3_backup@2"
        },
        {
          "command": "accountManagerForClaude.about",
          "when": "view == accountManagerForClaude.accountsView",
          "group": "9_about@1"
        }
      ],
      "commandPalette": [
        {
          "command": "accountManagerForClaude.removeAccount"
        },
        {
          "command": "accountManagerForClaude.renameAccount"
        }
      ]
    },
    "configuration": {
      "title": "Account Manager for Claude",
      "properties": {
        "accountManagerForClaude.autoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Regularly check the usage limits of all saved accounts (every `#accountManagerForClaude.pollIntervalSeconds#` seconds). When disabled, usage is only checked at startup, on manual refresh, and when a used-up limit is due to reset."
        },
        "accountManagerForClaude.pollIntervalSeconds": {
          "type": "number",
          "default": 240,
          "minimum": 60,
          "markdownDescription": "How often (in seconds, minimum 60 = 1 minute) to check usage limits for each account when `#accountManagerForClaude.autoRefresh#` is on. The usage endpoint is rate-limited: short intervals with many accounts can hit HTTP 429, after which that account is paused for 5 minutes."
        },
        "accountManagerForClaude.requestDelaySeconds": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 60,
          "markdownDescription": "Pause (in seconds) between requests to Anthropic. Accounts are checked one at a time, never in parallel, with this pause in between, so checking many accounts does not hit the rate limit (HTTP 429). Raise it if you still see 429 errors."
        },
        "accountManagerForClaude.notifyOnLimitReset": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a notification when a used-up limit (session, weekly, or a model-specific weekly limit) of a saved account becomes available again."
        },
        "accountManagerForClaude.autoReloadAfterSwitch": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Automatically reload the VS Code window after switching accounts (required for Claude Code to pick up the new account). When disabled, the extension asks first."
        },
        "accountManagerForClaude.credentialsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Claude Code `.credentials.json` file. Empty = default `~/.claude/.credentials.json`. On macOS, Claude Code keeps the login in the Keychain instead; this path's folder selects which Keychain item is used."
        },
        "accountManagerForClaude.warnThresholdPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "Usage threshold (%) from which limit bars and the status bar turn red. They turn orange from 75% of it (60% by default)."
        },
        "accountManagerForClaude.claudeCommand": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Claude Code CLI command used for login and Say Hi warmups. Use the full path to `claude.cmd`/`claude.exe` if VS Code cannot find `claude` in PATH."
        },
        "accountManagerForClaude.sayHiModel": {
          "type": "string",
          "default": "haiku",
          "markdownDescription": "Model passed to `claude -p` for Say Hi warmups. `haiku` is the low-cost/default warmup choice."
        },
        "accountManagerForClaude.sayHiPrompt": {
          "type": "string",
          "default": "Hi",
          "markdownDescription": "Prompt used by Say Hi warmups."
        },
        "accountManagerForClaude.sayHiTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 15,
          "markdownDescription": "Maximum time to wait for a Say Hi warmup command."
        },
        "accountManagerForClaude.usageHistory.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Collect a usage reading of every saved account every `#accountManagerForClaude.usageHistory.intervalSeconds#` seconds and keep it on this computer, for the usage analytics charts and the availability calendar. Readings that repeat the previous values are not stored again (except every 15 minutes)."
        },
        "accountManagerForClaude.usageHistory.intervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 60,
          "markdownDescription": "How often (in seconds, minimum 60) usage is read while `#accountManagerForClaude.usageHistory.enabled#` is on. Short periods with many accounts can hit the usage endpoint's rate limit (HTTP 429), which pauses that account for 5 minutes."
        },
        "accountManagerForClaude.usageHistory.retentionDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "markdownDescription": "How many days of collected usage history to keep."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node test/run-smoke.cjs",
    "build:vsix": "npm run package && vsce package",
    "install:vsix": "node -e \"const p=require('./package.json');require('child_process').execFileSync('code',['--install-extension',p.name+'-'+p.version+'.vsix'],{stdio:'inherit',shell:true})\"",
    "deploy": "npm run build:vsix && npm run install:vsix",
    "prepublish:check": "npm run typecheck && npm run test:smoke",
    "publish": "npm run prepublish:check && vsce publish",
    "release": "npm run prepublish:check && vsce publish patch"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "chart.js": "^4.5.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.23.0"
  }
}
